# 사이트 주소 (OG 이미지 절대 주소에 쓰임)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 로그인 — developers.kakao.com > 내 애플리케이션
KAKAO_CLIENT_ID=            # REST API 키
KAKAO_CLIENT_SECRET=        # (선택) 보안 > Client Secret을 켠 경우

# Google 로그인 + 원탭 자동 로그인 — console.cloud.google.com > Google Auth Platform > 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 지도 · 카카오톡 공유 (같은 카카오 앱의 JavaScript 키)
NEXT_PUBLIC_KAKAO_JS_KEY=
